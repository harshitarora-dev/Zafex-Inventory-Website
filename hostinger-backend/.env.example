# -------------------------------------------------------------
# Zafex Collectibles - Environment Variables Configuration
# -------------------------------------------------------------

# Server Port (Hostinger sets this automatically, or default 8080/3000)
PORT=8080
NODE_ENV=production

# Database Connection (Hostinger MySQL)
# Format: mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME
DATABASE_URL=mysql://u123456789_zafex:YourPasswordHere@localhost:3306/u123456789_zafex_db

# Or configure discrete MySQL parameters if preferred:
DB_HOST=localhost
DB_USER=u123456789_zafex
DB_PASSWORD=YourPasswordHere
DB_NAME=u123456789_zafex_db
DB_PORT=3306

# Session Security
SESSION_SECRET=zafex-super-secret-random-key-change-this-for-production
COOKIE_SECURE=false

# Admin Password for https://zafexcollectibles.com/admin/login
ADMIN_PASSWORD=admin123

# Razorpay Payment Gateway Credentials (from Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
